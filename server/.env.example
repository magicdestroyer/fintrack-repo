# FinTrack Server — Environment Variables
# Copy this to .env and fill in your values before starting

# Server port (default: 3001)
PORT=3001

# SQLite database file path (default: ./fintrack.db)
DB_PATH=./fintrack.db

# JWT secret — CHANGE THIS to a long random string in production!
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-string

# JWT expiry (default: 30 days)
JWT_EXPIRES_IN=30d

# Allowed origins for CORS (default: * — restrict in production)
# CORS_ORIGIN=https://yourdomain.com

# Node environment
NODE_ENV=development

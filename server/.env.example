# FinTrack Server — Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Comma-separated list of allowed CORS origins (production)
# CORS_ORIGIN=https://yourapp.onrender.com,https://yourapp.com

# ── Security (REQUIRED) ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-string-minimum-32-chars
JWT_EXPIRES_IN=30d

# ── Database ──────────────────────────────────────────────────────────────────
# Absolute path recommended for production (e.g. /data/fintrack.db on Render)
DB_PATH=./fintrack.db
# Set to 'true' to log all SQL queries (development only)
DB_VERBOSE=false

# ── Cache ─────────────────────────────────────────────────────────────────────
# Yahoo Finance price cache TTL in seconds (default: 900 = 15 minutes)
PRICE_CACHE_TTL_S=900

# ── bcrypt ────────────────────────────────────────────────────────────────────
# Cost factor for password hashing (10–14 recommended; higher = slower)
BCRYPT_ROUNDS=12

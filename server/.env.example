# FinTrack Server — Environment Variables
# Copy this file to .env and fill in your values

# JWT secret key — use a long random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_string

# Server port (default: 3001)
PORT=3001

# SQLite database file path (relative to server/ directory)
DB_PATH=./fintrack.db

# Token expiry (e.g. "7d", "30d", "90d")
JWT_EXPIRES_IN=30d

# CORS allowed origin — set to your dashboard's URL
# For local file:// usage, set to *
CORS_ORIGIN=*
